/**
 * 3. Status Seluruh Database - Teroptimasi dengan Script Cache
 */
function getAllStatus(bypassCache) {
  var cache = CacheService.getScriptCache();
  var cacheKey = "smkn1_all_status_v2";

  if (!bypassCache) {
    var cached = cache.get(cacheKey);
    if (cached) {
      try {
        var parsed = JSON.parse(cached);
        return { status: 'success', data: parsed, cached: true };
      } catch (e) {
        // Abaikan jika cache rusak, lanjutkan pembacaan baru
      }
    }
  }

  var dbs = getDatabases().data;
  var results = [];

  for (var i = 0; i < dbs.length; i++) {
    var db = dbs[i];
    var statusVal = 0;

    try {
      var ss = SpreadsheetApp.openById(db.id);
      var sheet = ss.getSheetByName("statusUjian");
      if (sheet) {
        var values = sheet.getRange("A1:B10").getValues();
        for (var j = 0; j < values.length; j++) {
          if (values[j][0] === "Asesmen_Sekolah") {
            statusVal = Number(values[j][1]) || 0;
            break;
          }
        }
      }
      results.push({
        id: db.id,
        name: db.name,
        group: db.group,
        status: statusVal
      });
    } catch (err) {
      results.push({
        id: db.id,
        name: db.name,
        group: db.group,
        status: 'Error',
        error: err.message
      });
    }
  }

  // Simpan ke cache jika setidaknya ada hasil
  if (results.length > 0) {
    try {
      cache.put(cacheKey, JSON.stringify(results), CACHE_TTL_STATUS);
    } catch (cacheErr) {
      // Abaikan jika ukuran data melebihi kuota cache
    }
  }

  return { status: 'success', data: results, cached: false };
}

/**
 * 4. Mendapatkan status tunggal
 */
function getStatus(dbId) {
  if (!dbId) return { status: 'error', message: 'ID database tidak valid.' };
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("statusUjian");
  if (!sheet) return { status: 'error', message: 'Sheet statusUjian tidak ditemukan.' };

  var values = sheet.getRange("A1:B10").getValues();
  for (var i = 0; i < values.length; i++) {
    if (values[i][0] === "Asesmen_Sekolah") {
      return { status: 'success', data: { statusUjian: Number(values[i][1]) || 0 } };
    }
  }
  return { status: 'error', message: 'Parameter Asesmen_Sekolah tidak ditemukan.' };
}

/**
 * 5. Mengubah status ujian satu kelas (Aktif / Nonaktif)
 */
function toggleStatus(dbId, newStatus) {
  if (!dbId) return { status: 'error', message: 'ID database tidak valid.' };
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("statusUjian");
  if (!sheet) return { status: 'error', message: 'Sheet statusUjian tidak ditemukan.' };

  var data = sheet.getDataRange().getValues();
  for (var i = 0; i < data.length; i++) {
    if (data[i][0] === "Asesmen_Sekolah") {
      var numericStatus = (Number(newStatus) === 1) ? 1 : 0;
      sheet.getRange(i + 1, 2).setValue(numericStatus);

      // Invalidate cache agar data segera terbarui
      CacheService.getScriptCache().remove("smkn1_all_status_v2");

      return {
        status: 'success',
        message: 'Status ujian berhasil diubah menjadi ' + (numericStatus === 1 ? 'AKTIF' : 'NONAKTIF')
      };
    }
  }
  return { status: 'error', message: 'Saklar Asesmen_Sekolah tidak ditemukan.' };
}

/**
 * 6. Mengubah status massal (Semua kelas atau filter angkatan)
 */
function toggleAllStatus(targetStatus, groupFilter) {
  var dbs = getDatabases().data;
  var numericStatus = (Number(targetStatus) === 1) ? 1 : 0;
  var successCount = 0;

  for (var i = 0; i < dbs.length; i++) {
    if (groupFilter && dbs[i].group !== groupFilter) continue;
    try {
      var ss = SpreadsheetApp.openById(dbs[i].id);
      var sheet = ss.getSheetByName("statusUjian");
      if (sheet) {
        var data = sheet.getDataRange().getValues();
        for (var j = 0; j < data.length; j++) {
          if (data[j][0] === "Asesmen_Sekolah") {
            sheet.getRange(j + 1, 2).setValue(numericStatus);
            successCount++;
            break;
          }
        }
      }
    } catch (e) {
      // lanjut ke database berikutnya jika terjadi kendala jaringan
    }
  }

  CacheService.getScriptCache().remove("smkn1_all_status_v2");
  return {
    status: 'success',
    message: 'Berhasil mengubah ' + successCount + ' kelas menjadi ' + (numericStatus === 1 ? 'AKTIF' : 'NONAKTIF')
  };
}

/**
 * 7. Mendapatkan daftar peserta yang sedang login / mengerjakan (status = 1)
 */
function getPesertaAktif(dbId) {
  if (!dbId) return { status: 'error', message: 'Pilih database terlebih dahulu.' };
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("DatabaseSiswa");
  if (!sheet) return { status: 'error', message: 'Sheet DatabaseSiswa tidak ditemukan.' };

  var data = sheet.getDataRange().getValues();
  var pesertaAktif = [];

  for (var i = 1; i < data.length; i++) {
    var username = (data[i][0] || '').toString().trim();
    var nama = (data[i][2] || '').toString().trim();
    var kelas = (data[i][3] || '').toString().trim();
    var status = Number(data[i][4]);

    if (username !== '' && status === 1) {
      pesertaAktif.push({
        username: username,
        nama: nama,
        kelas: kelas,
        rowIndex: i + 1
      });
    }
  }
  return { status: 'success', data: pesertaAktif };
}

/**
 * 8. Reset sesi ujian satu peserta
 */
function resetPeserta(dbId, targetUsername) {
  if (!dbId || !targetUsername) return { status: 'error', message: 'Parameter tidak lengkap.' };
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("DatabaseSiswa");
  if (!sheet) return { status: 'error', message: 'Sheet DatabaseSiswa tidak ditemukan.' };

  var data = sheet.getDataRange().getValues();
  var target = targetUsername.toString().trim().toLowerCase();

  for (var i = 1; i < data.length; i++) {
    var userRow = (data[i][0] || '').toString().trim().toLowerCase();
    if (userRow === target) {
      sheet.getRange(i + 1, 5).setValue(0);
      return { status: 'success', message: 'Peserta ' + targetUsername + ' berhasil direset.' };
    }
  }
  return { status: 'error', message: 'Username tidak ditemukan di database ini.' };
}

/**
 * 9. Reset sesi SEMUA peserta yang sedang aktif - OPTIMIZED BATCH WRITE
 * Mengganti setValue satu-per-satu di loop menjadi 1 kali setValues massal.
 */
function resetSemuaPeserta(dbId) {
  if (!dbId) return { status: 'error', message: 'Pilih database terlebih dahulu.' };
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("DatabaseSiswa");
  if (!sheet) return { status: 'error', message: 'Sheet DatabaseSiswa tidak ditemukan.' };

  var data = sheet.getDataRange().getValues();
  if (data.length <= 1) {
    return { status: 'success', message: 'Tidak ada data peserta.' };
  }

  var updatedCount = 0;
  var colEValues = [];

  // Update status kolom E di memori
  for (var i = 1; i < data.length; i++) {
    if (Number(data[i][4]) === 1) {
      colEValues.push([0]);
      updatedCount++;
    } else {
      colEValues.push([data[i][4]]);
    }
  }

  // Lakukan 1 kali batch write untuk seluruh kolom jika ada perubahan
  if (updatedCount > 0) {
    sheet.getRange(2, 5, colEValues.length, 1).setValues(colEValues);
  }

  return {
    status: 'success',
    message: updatedCount > 0
      ? 'Berhasil mereset ' + updatedCount + ' peserta aktif.'
      : 'Tidak ada peserta yang sedang berstatus aktif.'
  };
}

/**
 * 10. Mengambil data akun peserta ujian
 */
function getAkun(dbId) {
  if (!dbId) return { status: 'error', message: 'Pilih database terlebih dahulu.' };
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("DatabaseSiswa");
  if (!sheet) return { status: 'error', message: 'Sheet DatabaseSiswa tidak ditemukan.' };

  var data = sheet.getDataRange().getValues();
  var akun = [];

  for (var i = 1; i < data.length; i++) {
    var username = (data[i][0] || '').toString().trim();
    if (username !== "") {
      akun.push({
        rowIndex: i + 1,
        username: username,
        password: (data[i][1] || '').toString().trim(),
        nama: (data[i][2] || '').toString().trim(),
        kelas: (data[i][3] || '').toString().trim(),
        statusLogin: Number(data[i][4]) || 0
      });
    }
  }
  return { status: 'success', data: akun };
}

/**
 * 10b. Memperbarui Data Akun Peserta Ujian (Username, Kata Sandi, Nama Lengkap, Kelas)
 */
function updateAkun(dbId, rowIndex, originalUsername, akunData) {
  if (!dbId || !akunData || akunData.length < 4) {
    return { status: 'error', message: 'Parameter pembaruan akun tidak lengkap.' };
  }
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("DatabaseSiswa");
  if (!sheet) return { status: 'error', message: 'Sheet DatabaseSiswa tidak ditemukan.' };

  var newUsername = (akunData[0] || '').toString().trim();
  var newPassword = (akunData[1] || '').toString().trim();
  var newNama = (akunData[2] || '').toString().trim();
  var newKelas = (akunData[3] || '').toString().trim();

  if (!newUsername) {
    return { status: 'error', message: 'Username peserta tidak boleh kosong.' };
  }
  if (!newNama) {
    return { status: 'error', message: 'Nama lengkap peserta tidak boleh kosong.' };
  }

  var data = sheet.getDataRange().getValues();
  var targetRow = null;

  // 1. Cek kecocokan baris dengan rowIndex yang dikirim
  if (rowIndex && rowIndex >= 2 && rowIndex <= data.length) {
    var rowUser = (data[rowIndex - 1][0] || '').toString().trim().toLowerCase();
    if (!originalUsername || rowUser === originalUsername.toString().trim().toLowerCase()) {
      targetRow = rowIndex;
    }
  }

  // 2. Jika rowIndex belum valid, cari berdasarkan username lama
  if (!targetRow && originalUsername) {
    var origTarget = originalUsername.toString().trim().toLowerCase();
    for (var i = 1; i < data.length; i++) {
      if ((data[i][0] || '').toString().trim().toLowerCase() === origTarget) {
        targetRow = i + 1;
        break;
      }
    }
  }

  if (!targetRow) {
    return { status: 'error', message: 'Baris akun tidak ditemukan di database.' };
  }

  // Tulis pembaruan 4 kolom: Kolom 1 (Username), 2 (Password), 3 (Nama), 4 (Kelas)
  sheet.getRange(targetRow, 1, 1, 4).setValues([[newUsername, newPassword, newNama, newKelas]]);

  return {
    status: 'success',
    message: 'Data akun peserta ' + newNama + ' (' + newUsername + ') berhasil diperbarui.'
  };
}

/**
 * 11. Mengambil Pengaturan Nama Event Ujian
 */
function getEvent(dbId) {
  if (!dbId) return { status: 'error', message: 'Pilih database terlebih dahulu.' };
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("namaEvent");
  if (!sheet) return { status: 'error', message: 'Sheet namaEvent tidak ditemukan.' };

  var data = sheet.getDataRange().getValues();
  var events = [];

  for (var i = 1; i < data.length; i++) {
    if ((data[i][0] || '').toString().trim() !== "") {
      events.push({
        rowIndex: i + 1,
        kelas: data[i][0],
        event: data[i][1],
        tahun: data[i][2]
      });
    }
  }
  return { status: 'success', data: events };
}

/**
 * 12. Memperbarui Pengaturan Nama Event
 */
function updateEvent(dbId, rowIndex, eventData) {
  if (!dbId || !rowIndex || !eventData) {
    return { status: 'error', message: 'Data event tidak lengkap.' };
  }
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("namaEvent");
  if (!sheet) return { status: 'error', message: 'Sheet namaEvent tidak ditemukan.' };

  sheet.getRange(rowIndex, 1, 1, eventData.length).setValues([eventData]);
  return { status: 'success', message: 'Data Event berhasil diperbarui.' };
}

/**
 * Format waktu helper untuk menjaga stabilitas data ke JSON
 */
function formatCellTime(val) {
  if (!val && val !== 0) return "";
  if (val instanceof Date) {
    return Utilities.formatDate(val, "Asia/Jakarta", "HH:mm");
  }
  return val.toString().trim();
}

// Kamus Nama Hari dan Bulan Bahasa Indonesia Baku
var NAMA_HARI_ID = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
var NAMA_BULAN_ID = [
  'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
  'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
];

/**
 * Format tanggal ke Bahasa Indonesia baku (contoh: "Senin, 12 Oktober 2026")
 * Mencegah format bahasa Inggris (Monday, October 12) atau ISO string agar jadwal hari ini sinkron.
 */
function formatCellDate(val) {
  if (!val && val !== 0) return "";
  
  if (val instanceof Date) {
    var timeZoneOffset = 7 * 60; // UTC+7 (WIB)
    var utc = val.getTime() + (val.getTimezoneOffset() * 60000);
    var d = new Date(utc + (timeZoneOffset * 60000));
    
    var hari = NAMA_HARI_ID[d.getDay()];
    var tgl = d.getDate();
    var bln = NAMA_BULAN_ID[d.getMonth()];
    var thn = d.getFullYear();
    return hari + ", " + tgl + " " + bln + " " + thn;
  }
  
  var str = val.toString().trim();
  if (!str) return "";

  // Jika string merupakan ISO format (e.g. "2026-10-12T00:00:00.000Z" atau "2026-10-12")
  if (str.indexOf('T') !== -1 || /^\d{4}[-\/]\d{1,2}[-\/]\d{1,2}/.test(str)) {
    var parsedD = new Date(str);
    if (!isNaN(parsedD.getTime())) {
      var utc2 = parsedD.getTime() + (parsedD.getTimezoneOffset() * 60000);
      var dWib = new Date(utc2 + (7 * 3600000));
      return NAMA_HARI_ID[dWib.getDay()] + ", " + dWib.getDate() + " " + NAMA_BULAN_ID[dWib.getMonth()] + " " + dWib.getFullYear();
    }
  }

  // Jika numerik DD/MM/YYYY atau DD-MM-YYYY
  var dmyMatch = str.match(/^(\d{1,2})[-\/\.](\d{1,2})[-\/\.](\d{4})/);
  if (dmyMatch) {
    var dayNum = parseInt(dmyMatch[1], 10);
    var monthNum = parseInt(dmyMatch[2], 10) - 1;
    var yearNum = parseInt(dmyMatch[3], 10);
    var testDate = new Date(yearNum, monthNum, dayNum);
    if (!isNaN(testDate.getTime())) {
      return NAMA_HARI_ID[testDate.getDay()] + ", " + dayNum + " " + NAMA_BULAN_ID[monthNum] + " " + yearNum;
    }
  }

  // Terjemahkan nama hari atau bulan bahasa Inggris jika spreadsheet berisi teks bahasa Inggris
  var enToId = {
    'Sunday': 'Minggu', 'Monday': 'Senin', 'Tuesday': 'Selasa', 'Wednesday': 'Rabu',
    'Thursday': 'Kamis', 'Friday': 'Jumat', 'Saturday': 'Sabtu',
    'January': 'Januari', 'February': 'Februari', 'March': 'Maret', 'April': 'April',
    'May': 'Mei', 'June': 'Juni', 'July': 'Juli', 'August': 'Agustus',
    'September': 'September', 'October': 'Oktober', 'November': 'November', 'December': 'Desember',
    'Sun': 'Minggu', 'Mon': 'Senin', 'Tue': 'Selasa', 'Wed': 'Rabu', 'Thu': 'Kamis', 'Fri': 'Jumat', 'Sat': 'Sabtu',
    'Jan': 'Januari', 'Feb': 'Februari', 'Mar': 'Maret', 'Apr': 'April', 'Jun': 'Juni', 'Jul': 'Juli', 'Aug': 'Agustus', 'Sep': 'September', 'Oct': 'Oktober', 'Nov': 'November', 'Dec': 'Desember'
  };
  for (var en in enToId) {
    var regex = new RegExp('\\b' + en + '\\b', 'gi');
    str = str.replace(regex, enToId[en]);
  }
  return str;
}

/**
 * 13. Mengambil Jadwal Ujian berdasarkan Konsentrasi Keahlian
 */
function getJadwal(dbId, major) {
  if (!dbId || !major) return { status: 'error', message: 'Database atau jurusan tidak valid.' };
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName(major);
  if (!sheet) return { status: 'error', message: 'Sheet Jadwal (' + major + ') tidak ditemukan di database ini.' };

  var data = sheet.getDataRange().getValues();
  var jadwal = [];

  for (var i = 1; i < data.length; i++) {
    var rawRow = data[i];
    var tgl = formatCellDate(rawRow[0]);

    if (tgl !== "") {
      var rowClean = [
        tgl,
        (rawRow[1] || '').toString().trim(),
        formatCellTime(rawRow[2]),
        formatCellTime(rawRow[3]),
        (rawRow[4] || '').toString().trim(),
        (rawRow[5] || '').toString().trim(),
        formatCellTime(rawRow[6]),
        formatCellTime(rawRow[7]),
        (rawRow[8] || '').toString().trim(),
        (rawRow[9] || '').toString().trim(),
        formatCellTime(rawRow[10]),
        formatCellTime(rawRow[11]),
        (rawRow[12] || '').toString().trim()
      ];

      jadwal.push({
        rowIndex: i + 1,
        dataRow: rowClean
      });
    }
  }
  return { status: 'success', data: jadwal };
}

/**
 * 14. Menyimpan pembaruan Jadwal Ujian
 */
function updateJadwal(dbId, major, rowIndex, jadwalData) {
  if (!dbId || !major || !rowIndex || !jadwalData) {
    return { status: 'error', message: 'Data jadwal tidak lengkap.' };
  }
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName(major);
  if (!sheet) return { status: 'error', message: 'Sheet Jadwal (' + major + ') tidak ditemukan.' };

  sheet.getRange(rowIndex, 1, 1, jadwalData.length).setValues([jadwalData]);
  return { status: 'success', message: 'Jadwal ujian berhasil diperbarui.' };
}

/**
 * 15. Menambah Jadwal Ujian baru
 */
function addJadwal(dbId, major, jadwalData) {
  if (!dbId || !major || !jadwalData) {
    return { status: 'error', message: 'Data jadwal tidak lengkap.' };
  }
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName(major);
  if (!sheet) return { status: 'error', message: 'Sheet Jadwal (' + major + ') tidak ditemukan.' };

  sheet.appendRow(jadwalData);
  return { status: 'success', message: 'Jadwal ujian berhasil ditambahkan.' };
}

/**
 * 16. Mengambil Log Indikasi Kecurangan
 */
function getCurang(dbId) {
  if (!dbId) return { status: 'error', message: 'Pilih database terlebih dahulu.' };
  var ss = SpreadsheetApp.openById(dbId);
  var sheet = ss.getSheetByName("daftarCurang");
  if (!sheet) return { status: 'error', message: 'Sheet daftarCurang tidak ditemukan.' };

  var data = sheet.getDataRange().getValues();
  var curangList = [];

  for (var i = 1; i < data.length; i++) {
    var rawName = (data[i][1] || '').toString().trim();
    if (rawName !== "") {
      var w = data[i][0];
      var waktuStr = "";
      if (w instanceof Date) {
        waktuStr = Utilities.formatDate(w, "Asia/Jakarta", "dd/MM/yyyy HH:mm:ss");
      } else {
        waktuStr = (w || '').toString().trim();
      }

      curangList.push({
        waktu: waktuStr,
        nama: rawName,
        kelas: (data[i][2] || '').toString().trim(),
        mapel: (data[i][3] || '').toString().trim(),
        kecurangan: (data[i][4] || '').toString().trim()
      });
    }
  }
  return { status: 'success', data: curangList };
}
