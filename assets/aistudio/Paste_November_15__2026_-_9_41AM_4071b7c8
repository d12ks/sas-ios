// Konstanta durasi cache dalam detik
var CACHE_TTL_STATUS = 25; // 25 detik cache untuk status keseluruhan

/**
 * Handle GET requests - Berguna untuk cek kesehatan API (Health check)
 * dan pengujian langsung lewat browser.
 */
function doGet(e) {
  var action = (e && e.parameter && e.parameter.action) ? e.parameter.action : 'ping';
  var response = { status: 'success', message: 'API Aktif', timestamp: new Date().toISOString() };

  try {
    switch (action) {
      case 'ping':
        response.message = 'Sistem API Monitoring SMKN 1 Mondokan aktif & online.';
        break;
      case 'getDatabases':
        response = getDatabases();
        break;
      case 'getAllStatus':
        var bypassCache = (e.parameter.refresh === 'true');
        response = getAllStatus(bypassCache);
        break;
      default:
        response.message = 'Aksi GET tidak dikenali: ' + action;
    }
  } catch (err) {
    response = { status: 'error', message: err.toString() };
  }

  return createJsonResponse(response);
}

/**
 * Handle POST requests - Endpoint utama untuk dashboard
 */
function doPost(e) {
  var response = { status: 'error', message: 'Unknown error', data: null };

  try {
    if (!e || !e.postData || !e.postData.contents) {
      return createJsonResponse({ status: 'error', message: 'Payload data kosong.' });
    }

    var payload = JSON.parse(e.postData.contents);
    var action = payload.action;

    switch (action) {
      case 'login':
        response = handleLogin(payload.username, payload.password);
        break;

      case 'getDatabases':
        response = getDatabases();
        break;

      case 'getAllStatus':
        response = getAllStatus(payload.bypassCache === true);
        break;

      case 'getStatus':
        response = getStatus(payload.dbId);
        break;

      case 'toggleStatus':
        response = toggleStatus(payload.dbId, payload.newStatus);
        break;

      case 'toggleAllStatus':
        response = toggleAllStatus(payload.targetStatus, payload.groupFilter);
        break;

      case 'getPesertaAktif':
        response = getPesertaAktif(payload.dbId);
        break;

      case 'resetPeserta':
        response = resetPeserta(payload.dbId, payload.usernameTarget);
        break;

      case 'resetSemuaPeserta':
        response = resetSemuaPeserta(payload.dbId);
        break;

      case 'getAkun':
        response = getAkun(payload.dbId);
        break;

      case 'updateAkun':
        response = updateAkun(payload.dbId, payload.rowIndex, payload.originalUsername, payload.akunData);
        break;

      case 'getEvent':
        response = getEvent(payload.dbId);
        break;

      case 'updateEvent':
        response = updateEvent(payload.dbId, payload.rowIndex, payload.eventData);
        break;

      case 'getJadwal':
        response = getJadwal(payload.dbId, payload.major);
        break;

      case 'updateJadwal':
        response = updateJadwal(payload.dbId, payload.major, payload.rowIndex, payload.jadwalData);
        break;

      case 'addJadwal':
        response = addJadwal(payload.dbId, payload.major, payload.jadwalData);
        break;

      case 'getCurang':
        response = getCurang(payload.dbId);
        break;

      default:
        response.message = 'Action tidak dikenali: ' + action;
    }
  } catch (error) {
    response = {
      status: 'error',
      message: 'Server Error: ' + (error.message || error.toString())
    };
  }

  return createJsonResponse(response);
}

/**
 * Helper untuk membuat output JSON terstandar dengan header CORS
 */
function createJsonResponse(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

/**
 * 1. Otentikasi Proktor
 */
function handleLogin(username, password) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("User");
  if (!sheet) {
    throw new Error("Sheet 'User' tidak ditemukan pada spreadsheet master.");
  }

  var uTrim = (username || '').toString().trim().toLowerCase();
  var pTrim = (password || '').toString().trim();

  if (!uTrim || !pTrim) {
    return { status: 'error', message: 'Username dan password wajib diisi.' };
  }

  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    var dbUser = (data[i][0] || '').toString().trim().toLowerCase();
    var dbPass = (data[i][1] || '').toString().trim();
    var dbRole = (data[i][2] || 'Proktor').toString().trim();

    if (dbUser === uTrim && dbPass === pTrim) {
      return {
        status: 'success',
        message: 'Login berhasil.',
        data: {
          username: data[i][0].toString().trim(),
          role: dbRole
        }
      };
    }
  }
  return { status: 'error', message: 'Username atau password salah.' };
}

